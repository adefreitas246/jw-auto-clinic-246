# Expo public environment variables (prefix EXPO_PUBLIC_ is required for client-side access)
# Copy to .env.local and fill in your values.

# ── API ───────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_API_BASE_URL=https://your-backend.example.com

# ── Google OAuth (expo-auth-session/providers/google) ─────────────────────────
# Leave blank to hide the Google Sign-In button entirely.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=    # Web / Expo Go client ID (OAuth 2.0 web application)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=    # iOS client ID (OAuth 2.0 iOS application)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID= # Android client ID (OAuth 2.0 Android application)

# ── Apple Sign-In ─────────────────────────────────────────────────────────────
EXPO_PUBLIC_APPLE_CLIENT_ID=
EXPO_PUBLIC_APPLE_IOS_CLIENT_ID=
EXPO_PUBLIC_APPLE_ANDROID_CLIENT_ID=
