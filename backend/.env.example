# ── Server ───────────────────────────────────────────────────────────────────
PORT=8081
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/wash-hub

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_string
QR_SECRET=replace_with_another_long_random_string

# ── App URLs & Deep Links ─────────────────────────────────────────────────────
# Public HTTPS base URL of this server (used in password-reset emails)
APP_BASE_URL=https://your-server.onrender.com
# Deep-link base for in-app password reset (falls back to CLIENT_SCHEME)
APP_RESET_LINK_BASE=washhub://auth/reset-password
# Custom URL scheme registered in app.json
CLIENT_SCHEME=washhub
# Internal mobile API base (used by some routes to build absolute URLs)
API_BASE_URL=https://your-server.onrender.com/api

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-replace_with_your_key

# ── Email (SMTP / Gmail) ──────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
# 16-character Gmail App Password (not your account password)
SMTP_PASS=xxxx_xxxx_xxxx_xxxx
# Optional: override the From address shown in emails
SMTP_FROM="Wash Hub" <your@gmail.com>
# Address where support tickets are forwarded
SUPPORT_INBOX=support@yourbusiness.com

# ── OAuth ─────────────────────────────────────────────────────────────────────
# Apple Sign-In — must match the Bundle ID in app.json
APPLE_BUNDLE_ID=com.adefreitas.jwautoclinic
# Google Vision (used for licence-plate / document scanning)
GOOGLE_VISION_API_KEY=replace_with_your_key

# ── Payments (Caribbean) ──────────────────────────────────────────────────────
# WiPay (Trinidad & Tobago)
WIPAY_ACCOUNT_NUMBER=replace_with_wipay_account
# BimPay (Barbados)
BIMPAY_MERCHANT_ID=replace_with_bimpay_merchant_id

# ── SMS (optional — scaffold only, not active by default) ─────────────────────
# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_FROM_NUMBER=+18685551234
# Generic HTTP SMS gateway (e.g. Digicel/Flow)
SMS_GATEWAY_URL=https://your-sms-gateway.com/send
SMS_API_KEY=replace_with_sms_api_key
SMS_SENDER_ID=WashHub

# ── Assets ────────────────────────────────────────────────────────────────────
# Relative path to company logo used in PDF/email templates
LOGO_RELATIVE_PATH=./assets/logo.png
